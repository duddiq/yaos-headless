# ─── YAOS Headless Sync Configuration ─────────────────────────────────────────
#
# Copy this file to .env and fill in the values.

# The hostname of your YAOS Cloudflare Worker (without protocol).
# Example: yaos.my-account.workers.dev
YAOS_HOST=

# The vault ID used during claim/setup. This is shown on the Worker setup page.
YAOS_VAULT_ID=

# The auth token set during claim. Keep this secret.
YAOS_TOKEN=

# Local directory where .md files will be synced.
# Example: /srv/obsidian-vault  or  C:\Users\me\vault
YAOS_SYNC_DIR=./vault

# Optional: device name reported to the CRDT (visible in metadata).
YAOS_DEVICE_NAME=headless-server

# Optional: log level (debug | info | warn | error). Default: info
YAOS_LOG_LEVEL=info

# Optional: enable/disable attachment (blob) sync via R2. Default: true
YAOS_BLOB_SYNC=true

# Optional: max attachment size in KB. Default: 102400 (100MB)
# YAOS_MAX_ATTACHMENT_SIZE_KB=102400
